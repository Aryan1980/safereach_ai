# SafeReach AI Environment Variables Template
# Copy this file to .env.local for local development.

# Google Gemini API Key for AI Safety Assistant (Server-side only)
# Get a key at: https://aistudio.google.com/app/apikey
AI_API_KEY=your_gemini_api_key_here

# Optional Map API key if using custom map tile providers (Mapbox/Google Maps)
MAP_API_KEY=
